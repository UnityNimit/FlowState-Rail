# Local development only. Copy to Backend/.env and never commit the populated file.
DATABASE_URL=postgresql://postgres:password@host:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-rotated-service-role-key
SUPABASE_STORAGE_BUCKET=flowstate-private
WORKSPACE_TOKEN_SECRET=replace-with-a-long-random-value
CORS_ORIGINS=http://localhost:3000
WORKSPACE_TTL_HOURS=24
DEMO_MODE=true
